# LiveChat.com license ID from Settings → Channels → Website.
# When set, the official LiveChat widget loads (lower-left via CSS).
# Leave empty to use the built-in AI chat trained on site knowledge.
NEXT_PUBLIC_LIVECHAT_LICENSE_ID=

# --- Supabase (announcements / FAQ CMS) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Contact form (SMTP) -----------------------------------------------
# Mail settings for the account, from the Xserver control panel
# (サーバー管理 → メールアカウント設定 → 該当アカウント → メールソフト設定).
SMTP_HOST=
SMTP_PORT=587
# "true" for port 465 (SMTPS), "false" for port 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Inbox that receives inquiry-form submissions. Defaults to SMTP_USER if unset.
CONTACT_TO_EMAIL=

# --- AI chat (OpenAI) ----------------------------------------------------
# When set, the LiveChat AI assistant calls OpenAI, grounded in
# lib/chat-knowledge.ts. Falls back to keyword matching if unset.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
